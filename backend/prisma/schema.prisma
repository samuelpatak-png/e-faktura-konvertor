generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev/MVP. Swap provider to "postgresql" + a real DATABASE_URL
  // for production (Railway Postgres etc.) — schema below is portable as-is.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyProfile   CompanyProfile?
  sapiSkCredential SapiSkCredential?
  invoices         Invoice[]
  partners         Partner[]
  priceListItems   PriceListItem[]
  receivedInvoices ReceivedInvoice[]
  emailSettings    EmailSettings?
  reminderSettings ReminderSettings?
  sentEmails       SentEmail[]
}

model CompanyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  ico        String // 8-digit business registration number
  dic        String // 10-digit tax ID — also the Peppol participant ID (scheme 0245)
  icDph      String? // "SK" + 10 digits VAT ID, null if not a VAT payer
  street     String
  city       String
  postalCode String
  country    String @default("SK")
  iban       String
  bic        String?

  // WP6: PDF branding. Stored as base64 in the DB (not on disk / not in git — "nikdy neukladaj
  // do gitu" from the spec) since this app has no separate file-storage service; each pair is
  // null together (no data without a mimeType or vice versa).
  logoData          String?
  logoMimeType      String?
  stampData         String?
  stampMimeType     String?
  signatureData     String?
  signatureMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SapiSkCredential {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId               String
  encryptedClientSecret  String // AES-256-GCM ciphertext, see lib/crypto.ts
  mode                   String @default("mock") // "mock" | "live"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  SEND_FAILED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DocumentType {
  INVOICE
  CREDIT_NOTE // dobropis — UBL CreditNote-2, see services/xmlGenerator.ts generateCreditNoteXml
  ADVANCE_TAX_DOCUMENT // "daňový doklad k prijatej platbe" — a normal Invoice-2 with InvoiceTypeCode=386,
  // legally required only for a VAT-registered supplier (see WP4 handoff)
}

model Invoice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  number          String
  issueDate       String // YYYY-MM-DD
  dueDate         String // YYYY-MM-DD
  buyerReference  String // BT-10, mandatory under PEPPOL-EN16931-R003
  currency        String @default("EUR")
  status          InvoiceStatus @default(DRAFT)

  // Supplier snapshot at generation time (legal documents must not change retroactively
  // if the live CompanyProfile is edited later).
  supplierName       String
  supplierIco        String
  supplierDic        String
  supplierIcDph      String?
  supplierStreet     String
  supplierCity       String
  supplierPostalCode String
  supplierCountry    String
  supplierIban       String
  supplierBic        String?

  customerName       String
  customerIco        String?
  customerDic        String
  customerIcDph      String?
  customerStreet     String
  customerCity       String
  customerPostalCode String
  customerCountry    String @default("SK")
  // WP7: not part of the legal UBL document (xmlGenerator.ts is untouched by WP7 — this is
  // purely an operational "who do we email this to" field, snapshotted like the rest of the
  // customer block, not a BT-* field). Optional: SAPI-SK/Peppol delivery doesn't need it, and
  // invoices created before WP7 never had one. sendInvoiceEmail can also take an explicit
  // recipient at send time instead, so a missing value here never fully blocks emailing.
  customerEmail      String?

  netAmountCents   Int
  taxAmountCents   Int
  grossAmountCents Int

  xml                   String? // generated UBL XML, once generated
  sapiProviderDocumentId String?
  sentAt                 DateTime?

  // Payment tracking (WP3). `overdue`/`daysOverdue` are intentionally NOT columns — they're
  // derived from dueDate + paymentStatus + "now" at read time, see services/paymentStatus.ts.
  // A stored overdue flag would go stale the instant a day passes without a write.
  paidAmountCents Int           @default(0)
  paidAt          DateTime?
  paymentStatus   PaymentStatus @default(UNPAID)

  // WP4: credit notes and advance tax documents. `documentType: INVOICE` rows are the normal
  // case; paymentStatus/overdue are only meaningful for those (see paymentStatus.ts callers).
  documentType DocumentType @default(INVOICE)
  // Self-relation: for a CREDIT_NOTE, the invoice it corrects (BG-3 Preceding invoice
  // reference). Nullable because plain invoices and advance tax documents don't set it.
  originalInvoiceId String?
  original          Invoice?  @relation("InvoiceCorrections", fields: [originalInvoiceId], references: [id])
  corrections       Invoice[] @relation("InvoiceCorrections")

  // BT-113 — an advance already received that reduces this (final) invoice's payable amount.
  // No structured EN16931 field exists to reference which prior document it came from (see
  // WP4 handoff) — prepaidReference is carried as free text into the XML's cbc:Note.
  prepaidAmountCents Int?
  prepaidReference   String?

  lines      InvoiceLine[]
  sentEmails SentEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, number])
  @@index([originalInvoiceId])
}

// Customer address book. Keyed by userId, not a separate Company entity — this codebase has
// no multi-user-per-tenant concept anywhere else (CompanyProfile/SapiSkCredential/Invoice are
// all userId-keyed 1:1-per-account), so Partner follows the same pattern for consistency
// rather than introducing a new tenancy model the spec assumed but the schema doesn't have.
model Partner {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  ico   String? // 8-digit business registration number
  dic   String // 10-digit tax ID — required so a saved partner is immediately usable as an invoice customer
  icDph String? // "SK" + 10 digits VAT ID, null if not a VAT payer

  street      String
  city        String
  postalCode  String
  countryCode String @default("SK")

  // Stored for future cross-border/direct-Peppol-addressing use, but not yet consumed by
  // xmlGenerator.ts — the generator is still domestic-SK-only (scheme 0245 hardcoded), see
  // README "Čo ešte chýba". Not part of WP1's scope to wire up.
  peppolScheme String?
  peppolId     String?

  email    String?
  note     String? // free text, e.g. internal remarks
  category String? // free text, no fixed taxonomy (spec didn't define one)

  isActive Boolean @default(true) // soft delete — partners may be referenced by historical invoices

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([userId, name])
}

// Reusable catalogue of billable items/services, keyed by userId for the same reason as
// Partner (see comment above) — used to add invoice lines without retyping description/price.
model PriceListItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  unitCode       String @default("C62") // validated against backend/src/lib/unitCodes.ts (UN/ECE Rec 20)
  unitPriceCents Int
  vatRate        Int // 23 | 19 | 5 | 0 (Slovak rates as of 2026)
  sku            String?

  isActive Boolean @default(true) // soft delete — historical invoice lines keep their own snapshot

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([userId, name])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sortOrder      Int
  description    String
  quantity       Float @default(1) // display value only; lineNetCents below is the authoritative amount
  unitCode       String @default("C62") // UN/ECE Rec 20 unit code: C62=ks, HUR=hod, KGM=kg, MTR=m, LTR=l, DAY=deň
  unitPriceCents Int
  taxRatePercent Int // 23 | 19 | 5 | 0 (Slovak rates as of 2026)
  lineNetCents   Int // computed server-side via decimal.js at creation time, rounded to nearest cent
}

// WP5: an UBL Invoice-2/CreditNote-2 uploaded by the user (received from someone else's
// system) — parsed for a human-readable preview and validated, but never generated by us.
// Lines are stored as JSON, not a relation: they're read-only display data, never
// individually queried/edited/recomputed the way our own InvoiceLine rows are.
model ReceivedInvoice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType DocumentType // INVOICE | CREDIT_NOTE in practice for anything a real sender emits
  number       String
  issueDate    String
  dueDate      String?
  currency     String @default("EUR")

  supplierName       String
  supplierIco        String?
  supplierDic        String?
  supplierIcDph      String?
  supplierStreet     String?
  supplierCity       String?
  supplierPostalCode String?
  supplierCountry    String?

  customerName String?
  customerDic  String?

  netAmountCents   Int
  taxAmountCents   Int
  grossAmountCents Int

  linesJson String // JSON-serialized ParsedLine[] — see services/ublParser.ts

  paidAmountCents Int           @default(0)
  paidAt          DateTime?
  paymentStatus   PaymentStatus @default(UNPAID)

  rawXml   String // the uploaded document, verbatim, so re-validation never needs a re-upload
  fileName String?

  // Our own invoiceValidator.ts checks (already human-readable Slovak) — see ublParser.ts.
  ourErrors   String // JSON string[]
  ourWarnings String // JSON string[]
  // Official KOSIT/Peppol Schematron verdict, run against the raw uploaded XML — null until
  // validated (or if the KOSIT toolchain isn't available). kositMessages are the *raw* English
  // Schematron failure texts, shown as supplementary technical detail — see WP5 handoff for
  // why these aren't translated to Slovak (hundreds of possible rules, not something to guess at).
  kositAcceptable Boolean?
  kositMessages   String? // JSON string[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// WP7: per-company SMTP configuration for sending invoice emails. Chose SMTP over a
// transactional-email provider (Resend/SendGrid/Postmark/...) — see WP7 handoff for the
// reasoning (lower setup friction for a non-technical small-business owner who already has an
// email account, no extra third-party signup/domain-verification, sender identity is the
// company's own address). Credentials encrypted the same way as SapiSkCredential.
model EmailSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  smtpHost              String
  smtpPort              Int
  smtpSecure            Boolean @default(true) // true = implicit TLS (465), false = STARTTLS/plain (587/25)
  smtpUser              String
  encryptedSmtpPassword String // AES-256-GCM ciphertext, see lib/crypto.ts

  fromEmail String
  fromName  String

  // {{invoiceNumber}}, {{amount}}, {{dueDate}}, {{customerName}} — see services/emailTemplate.ts
  subjectTemplate String @default("Faktúra {{invoiceNumber}}")
  bodyTemplate    String @default("Dobrý deň,\n\nv prílohe posielame faktúru č. {{invoiceNumber}} na sumu {{amount}} so splatnosťou {{dueDate}}.\n\nS pozdravom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// WP7: per-company reminder cadence + text. Reminder N is due `firstReminderDays +
// (N-1)*intervalDays` days after the invoice's dueDate, up to reminderCount reminders total —
// a direct reading of "koľko dní po splatnosti, počet upomienok, odstupy" from the spec.
model ReminderSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled           Boolean @default(false)
  firstReminderDays Int     @default(7)
  reminderCount     Int     @default(3)
  intervalDays      Int     @default(7)

  subjectTemplate String @default("Upomienka: Faktúra {{invoiceNumber}} po splatnosti")
  bodyTemplate    String @default("Dobrý deň,\n\npripomíname, že faktúra č. {{invoiceNumber}} na sumu {{amount}} so splatnosťou {{dueDate}} nebola doteraz uhradená. Prosíme o úhradu v čo najkratšom čase.\n\nS pozdravom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SentEmailType {
  INVOICE
  REMINDER
}

enum SentEmailStatus {
  SENT
  FAILED
}

// WP7: log of every send attempt (not just successes — a FAILED row is what lets the UI show
// "last attempt failed: <reason>" instead of silently looking like nothing happened).
// reminderNumber is only set for type=REMINDER; it's how the scheduler checks "has reminder #2
// for this invoice already gone out" before sending again — see services/reminderScheduler.ts
// for why that check is a plain query rather than a DB unique constraint (a FAILED attempt
// must not permanently block a retry of the same reminder number).
model SentEmail {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type           SentEmailType
  reminderNumber Int?
  toEmail        String
  subject        String
  status         SentEmailStatus
  errorMessage   String?

  sentAt DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}
