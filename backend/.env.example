# Copy to .env and fill in real values. Never commit .env.

# SQLite for local dev. For production, point this at a Postgres URL instead
# (Prisma makes the switch a one-line change to schema.prisma's provider).
DATABASE_URL="file:./dev.db"

PORT=4000

# Long random string used to sign auth JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 32-byte (64 hex char) key used to encrypt SAPI-SK client secrets at rest (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Set to "true" only when serving over HTTPS in production (marks the auth cookie Secure).
COOKIE_SECURE=false

# Frontend origin allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173

# "mock" (default, safe) simulates SAPI-SK responses with no network calls.
# "live" makes real calls using the researched-but-unverified SAPI-SK contract below —
# confirm the exact contract against your own SAPI-SK portal docs before switching this.
SAPI_SK_MODE=mock
SAPI_SK_BASE_URL=https://api.efaktura.sk/sapi

# Optional — system SMTP the app itself sends FROM (password reset + email verification links).
# Distinct from the per-tenant SMTP a company configures in Nastavenia to email its own
# customers. Left blank, those two flows stay silently disabled (register/login still work
# fine; requests just log a server-side error and answer the user generically — see
# authController.ts) rather than the app failing to boot.
APP_SMTP_HOST=
APP_SMTP_PORT=
APP_SMTP_SECURE=true
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_FROM_EMAIL=
APP_SMTP_FROM_NAME=e-Faktúra Konvertor

# Optional — error tracking (https://sentry.io). Leave blank to keep it fully inactive; no
# account is required to run the app. See src/instrument.ts.
SENTRY_DSN=
